{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.lorenz.ai/skills/strategy-designer/output/v1alpha1",
  "title": "StrategyDesignerOutput",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "evidenceGate",
    "decision",
    "strategySpec",
    "confirmation",
    "warnings",
    "openQuestions"
  ],
  "properties": {
    "schemaVersion": {
      "const": "lorenz.trading/strategy-design/v1alpha1"
    },
    "evidenceGate": {
      "enum": [
        "ELIGIBLE_STRATEGY_EVIDENCE",
        "TIER_3_ONLY_FAILURE_MODE",
        "INSUFFICIENT_EVIDENCE"
      ]
    },
    "decision": {
      "enum": [
        "READY_FOR_OWNER_CONFIRMATION",
        "NEEDS_REVISION",
        "INSUFFICIENT_EVIDENCE"
      ]
    },
    "strategySpec": {
      "oneOf": [
        {"$ref": "#/$defs/strategySpec"},
        {"type": "null"}
      ]
    },
    "confirmation": {
      "$ref": "#/$defs/confirmation"
    },
    "warnings": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "string",
        "maxLength": 1000
      }
    },
    "openQuestions": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "string",
        "maxLength": 1000
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "decision": {"const": "READY_FOR_OWNER_CONFIRMATION"}
        },
        "required": ["decision"]
      },
      "then": {
        "properties": {
          "evidenceGate": {"const": "ELIGIBLE_STRATEGY_EVIDENCE"},
          "strategySpec": {"$ref": "#/$defs/strategySpec"}
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision": {"const": "INSUFFICIENT_EVIDENCE"}
        },
        "required": ["decision"]
      },
      "then": {
        "properties": {
          "strategySpec": {"type": "null"}
        }
      }
    },
    {
      "if": {
        "properties": {
          "evidenceGate": {"const": "TIER_3_ONLY_FAILURE_MODE"}
        },
        "required": ["evidenceGate"]
      },
      "then": {
        "properties": {
          "decision": {"const": "INSUFFICIENT_EVIDENCE"},
          "strategySpec": {"type": "null"}
        }
      }
    }
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "modelFamily": {
      "enum": [
        "baseline_cash",
        "benchmark",
        "ridge",
        "elastic_net",
        "robust_linear",
        "lightgbm",
        "causal_tcn",
        "tcn_attention",
        "compact_transformer",
        "ensemble"
      ]
    },
    "baselineModelFamily": {
      "enum": ["baseline_cash", "benchmark"]
    },
    "strategySpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "specVersion",
        "name",
        "qualificationStatus",
        "researchTrace",
        "universe",
        "target",
        "featureGroups",
        "modelLane",
        "signalPolicy",
        "executionAssumptions",
        "allocationConstraints",
        "immutablePolicyRefs",
        "assumptions",
        "falsificationCriteria",
        "failureModes"
      ],
      "properties": {
        "specVersion": {
          "const": "lorenz.trading/strategy-spec/v1alpha1"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "qualificationStatus": {
          "const": "DRAFT_UNCONFIRMED"
        },
        "researchTrace": {
          "type": "object",
          "additionalProperties": false,
          "required": ["evidenceBundleDigest", "hypothesisId", "claimIds"],
          "properties": {
            "evidenceBundleDigest": {"$ref": "#/$defs/digest"},
            "hypothesisId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "claimIds": {
              "type": "array",
              "minItems": 1,
              "maxItems": 100,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              }
            }
          }
        },
        "universe": {
          "type": "object",
          "additionalProperties": false,
          "required": ["universeId", "digest", "symbols"],
          "properties": {
            "universeId": {"const": "us_liquid_etf_20_v2"},
            "digest": {"$ref": "#/$defs/digest"},
            "symbols": {
              "const": [
                "SPY",
                "QQQ",
                "IWM",
                "DIA",
                "XLB",
                "XLE",
                "XLF",
                "XLI",
                "XLK",
                "XLP",
                "XLU",
                "XLV",
                "XLY",
                "VOX",
                "VNQ",
                "MDY",
                "VUG",
                "VTV",
                "IWF",
                "IWD"
              ]
            }
          }
        },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["primary", "auxiliary"],
          "properties": {
            "primary": {"const": "five_session_excess_return"},
            "auxiliary": {
              "const": [
                "one_session_excess_return",
                "twenty_session_excess_return"
              ]
            }
          }
        },
        "featureGroups": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "enum": [
              "returns",
              "relative_returns",
              "momentum",
              "reversal",
              "volatility",
              "downside_volatility",
              "volume",
              "turnover",
              "spread_proxy",
              "beta",
              "correlation",
              "dispersion",
              "breadth",
              "drawdown",
              "regime"
            ]
          }
        },
        "modelLane": {
          "type": "object",
          "additionalProperties": false,
          "required": ["family", "role", "baselineFamilies"],
          "properties": {
            "family": {"$ref": "#/$defs/modelFamily"},
            "role": {"enum": ["BASELINE", "CHALLENGER"]},
            "baselineFamilies": {
              "type": "array",
              "minItems": 1,
              "maxItems": 2,
              "uniqueItems": true,
              "items": {"$ref": "#/$defs/baselineModelFamily"}
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "family": {
                    "enum": [
                      "ridge",
                      "elastic_net",
                      "robust_linear",
                      "lightgbm",
                      "causal_tcn",
                      "tcn_attention",
                      "compact_transformer",
                      "ensemble"
                    ]
                  }
                },
                "required": ["family"]
              },
              "then": {
                "properties": {
                  "role": {"const": "CHALLENGER"}
                }
              }
            },
            {
              "if": {
                "properties": {
                  "role": {"const": "BASELINE"}
                },
                "required": ["role"]
              },
              "then": {
                "properties": {
                  "family": {"enum": ["baseline_cash", "benchmark"]}
                }
              }
            }
          ]
        },
        "signalPolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["noTradeAllowed", "confidenceRule", "abstentionRule"],
          "properties": {
            "noTradeAllowed": {"const": true},
            "confidenceRule": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "abstentionRule": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            }
          }
        },
        "executionAssumptions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "historicalFeed",
            "decisionTiming",
            "earliestExecution",
            "sameCloseAllowed",
            "overnightTradingAllowed",
            "fractionalOrdersAllowed"
          ],
          "properties": {
            "historicalFeed": {"const": "sip"},
            "decisionTiming": {"const": "after_close_t"},
            "earliestExecution": {"const": "next_session"},
            "sameCloseAllowed": {"const": false},
            "overnightTradingAllowed": {"const": false},
            "fractionalOrdersAllowed": {"const": false}
          }
        },
        "allocationConstraints": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "longOnly",
            "leverageAllowed",
            "shortAllowed",
            "optionsAllowed",
            "cryptoAllowed",
            "maxGross",
            "maxPosition",
            "targetVolatility"
          ],
          "properties": {
            "longOnly": {"const": true},
            "leverageAllowed": {"const": false},
            "shortAllowed": {"const": false},
            "optionsAllowed": {"const": false},
            "cryptoAllowed": {"const": false},
            "maxGross": {"type": "number", "exclusiveMinimum": 0, "maximum": 0.5},
            "maxPosition": {"type": "number", "exclusiveMinimum": 0, "maximum": 0.1},
            "targetVolatility": {"type": "number", "exclusiveMinimum": 0, "maximum": 0.08}
          }
        },
        "immutablePolicyRefs": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "riskPolicyDigest",
            "costModelDigest",
            "benchmarkDigest",
            "evaluatorDigest"
          ],
          "properties": {
            "riskPolicyDigest": {"$ref": "#/$defs/digest"},
            "costModelDigest": {"$ref": "#/$defs/digest"},
            "benchmarkDigest": {"$ref": "#/$defs/digest"},
            "evaluatorDigest": {"$ref": "#/$defs/digest"}
          }
        },
        "assumptions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "falsificationCriteria": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "failureModes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        }
      }
    },
    "confirmation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "status", "summary", "assumptionDiffs"],
      "properties": {
        "required": {"const": true},
        "status": {"const": "NOT_CONFIRMED"},
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 3000
        },
        "assumptionDiffs": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["requested", "applied", "reason"],
            "properties": {
              "requested": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "applied": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              }
            }
          }
        }
      }
    }
  }
}
